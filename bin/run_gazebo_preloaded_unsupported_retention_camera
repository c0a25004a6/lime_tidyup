#!/usr/bin/env bash
set -eo pipefail

ARTIFACT_DIR="${1:-/artifacts}"
mkdir -p "${ARTIFACT_DIR}"
INPUT_JSON="${ARTIFACT_DIR}/rubiks_preloaded_unsupported_retention_camera_gate_input.json"
test -s "${INPUT_JSON}"

source /opt/ros/humble/setup.bash
source /root/turtlebot3_ws/install/setup.bash
set -u

export GAZEBO_MODEL_PATH="${GAZEBO_MODEL_PATH:-}:/root/.gazebo/models:/opt/ros/humble/share/turtlebot3_gazebo/models"
export GAZEBO_PLUGIN_PATH="${GAZEBO_PLUGIN_PATH:-}:/opt/ros/humble/lib"
export DISPLAY=:99

MODEL_NAME="turtlebot3_lime_gripper_test"
CAMERA_MODEL="rubiks_physics_observer_camera"
URDF_PATH="${ARTIFACT_DIR}/turtlebot3_lime_preloaded_unsupported_retention_camera.urdf"
SERVER_LOG="${ARTIFACT_DIR}/rubiks_preloaded_unsupported_retention_camera.gzserver.log"
RSP_LOG="${ARTIFACT_DIR}/rubiks_preloaded_unsupported_retention_camera.robot_state_publisher.log"
SETUP_JSON="${ARTIFACT_DIR}/rubiks_preloaded_unsupported_retention_camera_anchor_setup.json"
RESULT_JSON="${ARTIFACT_DIR}/rubiks_preloaded_unsupported_retention_camera_summary.json"
FRAME_DIR="${ARTIFACT_DIR}/rubiks_preloaded_unsupported_retention_camera_frames"
VIDEO_PATH="${ARTIFACT_DIR}/rubiks_preloaded_unsupported_retention_camera.mp4"
CLOSEUP_VIDEO_PATH="${ARTIFACT_DIR}/rubiks_preloaded_unsupported_retention_camera_closeup.mp4"
VIDEO_METADATA="${ARTIFACT_DIR}/rubiks_preloaded_unsupported_retention_camera_video.json"
VIDEO_FFPROBE="${ARTIFACT_DIR}/rubiks_preloaded_unsupported_retention_camera_ffprobe.json"
CLOSEUP_FFPROBE="${ARTIFACT_DIR}/rubiks_preloaded_unsupported_retention_camera_closeup_ffprobe.json"
CAMERA_TOPICS_LOG="${ARTIFACT_DIR}/rubiks_preloaded_unsupported_retention_camera_topics.log"

cleanup() {
  status=$?
  for pid in "${GZSERVER_PID:-}" "${RSP_PID:-}" "${XVFB_PID:-}"; do
    if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then kill -INT "${pid}" 2>/dev/null || true; fi
  done
  sleep 2
  for pid in "${GZSERVER_PID:-}" "${RSP_PID:-}" "${XVFB_PID:-}"; do
    if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then kill -TERM "${pid}" 2>/dev/null || true; wait "${pid}" 2>/dev/null || true; fi
  done
  exit "${status}"
}
trap cleanup EXIT INT TERM

ros2_service_available() {
  local service_type
  service_type="$(timeout 5 ros2 service type "$1" 2>/dev/null)" || return 1
  [[ -n "${service_type}" ]]
}
ros2_action_available() {
  local output padded
  output="$(timeout 5 ros2 action list 2>/dev/null)" || return 1
  padded=$'\n'"${output}"$'\n'
  [[ "${padded}" == *$'\n'"$1"$'\n'* ]]
}

rm -rf "${FRAME_DIR}"
rm -f "${VIDEO_PATH}" "${CLOSEUP_VIDEO_PATH}" "${VIDEO_METADATA}" "${VIDEO_FFPROBE}" "${CLOSEUP_FFPROBE}"
mkdir -p "${FRAME_DIR}"

Xvfb :99 -screen 0 1280x720x24 -nolisten tcp >"${ARTIFACT_DIR}/rubiks_preloaded_unsupported_retention_camera.xvfb.log" 2>&1 &
XVFB_PID=$!
sleep 1
kill -0 "${XVFB_PID}" 2>/dev/null || { cat "${ARTIFACT_DIR}/rubiks_preloaded_unsupported_retention_camera.xvfb.log"; exit 2; }

xacro /project/resource/turtlebot3_lime_pregrasp_hold_test.urdf.xacro >"${URDF_PATH}"
grep -q 'libgazebo_ros2_control.so' "${URDF_PATH}"
! grep -q 'libgazebo_grasp_fix.so' "${URDF_PATH}"
! grep -q 'libgazebo_ros_link_attacher.so' "${URDF_PATH}"
! grep -q 'libgazebo_ros_diff_drive.so' "${URDF_PATH}"

ros2 run robot_state_publisher robot_state_publisher "${URDF_PATH}" --ros-args -p use_sim_time:=true >"${RSP_LOG}" 2>&1 &
RSP_PID=$!
sleep 2
kill -0 "${RSP_PID}" 2>/dev/null || { cat "${RSP_LOG}"; exit 3; }

# Gazebo Classic's official --lockstep mode makes physics wait for sensor updates.
# This is evidence-only scheduling: the robot/cube/contact parameters are unchanged.
gzserver --lockstep /project/resource/rubiks_grasp_calibration.world -s libgazebo_ros_init.so -s libgazebo_ros_factory.so >"${SERVER_LOG}" 2>&1 &
GZSERVER_PID=$!
for _ in $(seq 1 120); do
  if ros2_service_available '/spawn_entity' && ros2_service_available '/delete_entity'; then break; fi
  kill -0 "${GZSERVER_PID}" 2>/dev/null || { cat "${SERVER_LOG}"; exit 4; }
  sleep 1
done
ros2_service_available '/spawn_entity' || { cat "${SERVER_LOG}"; exit 4; }
ros2_service_available '/delete_entity' || { cat "${SERVER_LOG}"; exit 4; }

ros2 run gazebo_ros spawn_entity.py -entity "${MODEL_NAME}" -file "${URDF_PATH}" -x 0 -y 0 -z 0.03 -Y 0 >"${ARTIFACT_DIR}/camera_retention.robot_spawn.log" 2>&1
for _ in $(seq 1 120); do
  ros2_service_available '/controller_manager/list_controllers' && break
  kill -0 "${GZSERVER_PID}" 2>/dev/null || { cat "${SERVER_LOG}"; exit 5; }
  sleep 1
done
ros2_service_available '/controller_manager/list_controllers' || exit 5

ros2 run controller_manager spawner joint_state_broadcaster --controller-manager /controller_manager >"${ARTIFACT_DIR}/camera_joint_state_broadcaster.spawner.log" 2>&1
ros2 run controller_manager spawner arm_controller --controller-manager /controller_manager >"${ARTIFACT_DIR}/camera_arm_controller.spawner.log" 2>&1
ros2 run controller_manager spawner gripper_controller --controller-manager /controller_manager >"${ARTIFACT_DIR}/camera_gripper_controller.spawner.log" 2>&1
for _ in $(seq 1 90); do
  if ros2_action_available '/arm_controller/follow_joint_trajectory' && ros2_action_available '/gripper_controller/gripper_cmd'; then break; fi
  sleep 1
done
ros2_action_available '/arm_controller/follow_joint_trajectory' || exit 6
ros2_action_available '/gripper_controller/gripper_cmd' || exit 6

sleep 2
python3 /root/bin/run_rubiks_open_arm_pregrasp_setup.py \
  --input "${INPUT_JSON}" --output "${SETUP_JSON}" --arm-seconds 3.0 --timeout 12.0 \
  >"${ARTIFACT_DIR}/rubiks_preloaded_unsupported_retention_camera_anchor_setup.stdout.json" \
  2>"${ARTIFACT_DIR}/rubiks_preloaded_unsupported_retention_camera_anchor_setup.stderr.log"

# Keep the proven first-run observer pose. The raw video preserves the full frame;
# a second review-only close-up video crops the upper-left gripper/cube region.
ros2 run gazebo_ros spawn_entity.py \
  -entity "${CAMERA_MODEL}" \
  -file /project/resource/rubiks_physics_observer_camera.sdf \
  -reference_frame "${MODEL_NAME}::link7" \
  -x 0.18 -y -0.22 -z 0.12 -R 0.0 -P 0.410 -Y 2.113 \
  >"${ARTIFACT_DIR}/rubiks_preloaded_unsupported_retention_camera.spawn.log" 2>&1

CAMERA_TOPIC=""
for _ in $(seq 1 90); do
  timeout 5 ros2 topic list >"${CAMERA_TOPICS_LOG}" 2>&1 || true
  CAMERA_TOPIC="$(grep -E '^/rubiks_physics_camera(/[^[:space:]]*)?/image_raw$' "${CAMERA_TOPICS_LOG}" | head -n 1 || true)"
  if [[ -n "${CAMERA_TOPIC}" ]]; then break; fi
  kill -0 "${GZSERVER_PID}" 2>/dev/null || { cat "${SERVER_LOG}"; exit 7; }
  sleep 0.5
done
if [[ -z "${CAMERA_TOPIC}" ]]; then
  echo 'Gazebo observer image topic not found' >&2
  cat "${CAMERA_TOPICS_LOG}" >&2 || true
  exit 7
fi
CAMERA_TOPIC_TYPE="$(timeout 5 ros2 topic type "${CAMERA_TOPIC}" 2>/dev/null || true)"
[[ "${CAMERA_TOPIC_TYPE}" == "sensor_msgs/msg/Image" ]] || {
  echo "unexpected camera topic type: ${CAMERA_TOPIC_TYPE}" >&2
  exit 7
}
printf '%s\n' "${CAMERA_TOPIC}" >"${ARTIFACT_DIR}/rubiks_preloaded_unsupported_retention_camera_topic.txt"

# Require native Gazebo save to produce at least one frame before beginning the
# physics trial. This proves the artifact is the simulator's camera output.
for _ in $(seq 1 120); do
  if find "${FRAME_DIR}" -maxdepth 1 -type f -iname '*.jpg' -print -quit | grep -q .; then break; fi
  kill -0 "${GZSERVER_PID}" 2>/dev/null || { cat "${SERVER_LOG}"; exit 8; }
  sleep 0.25
done
find "${FRAME_DIR}" -maxdepth 1 -type f -iname '*.jpg' -print -quit | grep -q . || {
  echo 'Gazebo-native camera did not save a first frame' >&2
  exit 8
}

set +e
python3 /root/bin/run_rubiks_preloaded_unsupported_retention.py \
  --input "${INPUT_JSON}" --output "${RESULT_JSON}" \
  --cube-sdf /project/resource/rubiks_dynamic_cube_supported_057.sdf \
  --support-sdf /project/resource/rubiks_cube_support_surface.sdf \
  --settle-seconds 2.0 --supported-hold-seconds 1.0 --unsupported-seconds 1.0 \
  --close-start 0.0185 --close-stop 0.0060 --close-step 0.00025 \
  --step-hold 0.12 --max-effort 0.25 --timeout 10.0 \
  >"${ARTIFACT_DIR}/rubiks_preloaded_unsupported_retention_camera.stdout.json" \
  2>"${ARTIFACT_DIR}/rubiks_preloaded_unsupported_retention_camera.stderr.log"
TRIAL_STATUS=$?
set -e
printf '%s\n' "${TRIAL_STATUS}" >"${ARTIFACT_DIR}/rubiks_preloaded_unsupported_retention_camera_trial_exit_code.txt"

# Stop Gazebo before finalizing frames so the native save directory is immutable.
if kill -0 "${GZSERVER_PID}" 2>/dev/null; then
  kill -INT "${GZSERVER_PID}" 2>/dev/null || true
  wait "${GZSERVER_PID}" 2>/dev/null || true
fi
GZSERVER_PID=""
sleep 1

FRAME_COUNT="$(find "${FRAME_DIR}" -maxdepth 1 -type f -iname '*.jpg' | wc -l | tr -d ' ')"
[[ "${FRAME_COUNT}" -gt 0 ]] || { echo 'no Gazebo-native camera frames after trial' >&2; exit 9; }
printf '%s\n' "${FRAME_COUNT}" >"${ARTIFACT_DIR}/rubiks_preloaded_unsupported_retention_camera_frame_count.txt"

ffmpeg -y -loglevel error \
  -framerate 30 -pattern_type glob -i "${FRAME_DIR}/*.jpg" \
  -c:v libx264 -preset veryfast -crf 20 -pix_fmt yuv420p \
  "${VIDEO_PATH}"

# Review-only crop: preserves actual Gazebo pixels, magnifying the region that
# contains the selected cube and both fingers in the proven observer view.
ffmpeg -y -loglevel error -i "${VIDEO_PATH}" \
  -vf 'crop=320:240:0:0,scale=640:480:flags=lanczos' \
  -c:v libx264 -preset veryfast -crf 18 -pix_fmt yuv420p \
  "${CLOSEUP_VIDEO_PATH}"

ffprobe -v error \
  -show_entries stream=codec_name,width,height,avg_frame_rate,nb_frames:format=duration,size \
  -of json "${VIDEO_PATH}" >"${VIDEO_FFPROBE}"
ffprobe -v error \
  -show_entries stream=codec_name,width,height,avg_frame_rate,nb_frames:format=duration,size \
  -of json "${CLOSEUP_VIDEO_PATH}" >"${CLOSEUP_FFPROBE}"

python3 - "${FRAME_DIR}" "${VIDEO_METADATA}" "${VIDEO_FFPROBE}" "${CAMERA_TOPIC}" <<'PY'
import json
import sys
from pathlib import Path
frame_dir=Path(sys.argv[1])
metadata_path=Path(sys.argv[2])
probe=json.loads(Path(sys.argv[3]).read_text())
topic=sys.argv[4]
frames=sorted(frame_dir.glob('*.jpg'))
stream=(probe.get('streams') or [{}])[0]
fmt=probe.get('format') or {}
frame_count=len(frames)
payload={
    'schema_version':2,
    'capture_source':'GAZEBO_CLASSIC_CAMERA_NATIVE_SAVE',
    'gazebo_lockstep':True,
    'camera_update_rate_hz':30.0,
    'camera_topic':topic,
    'frame_count':frame_count,
    'first_frame':frames[0].name if frames else None,
    'last_frame':frames[-1].name if frames else None,
    'width':int(stream.get('width',0)),
    'height':int(stream.get('height',0)),
    'video_duration_s':float(fmt.get('duration',0.0)),
    'video_size_bytes':int(fmt.get('size',0)),
    'minimum_required_frames':300,
    'minimum_required_duration_s':10.0,
    'passed':(
        frame_count >= 300
        and int(stream.get('width',0)) == 640
        and int(stream.get('height',0)) == 480
        and float(fmt.get('duration',0.0)) >= 10.0
        and int(fmt.get('size',0)) >= 10000
    ),
}
metadata_path.write_text(json.dumps(payload,indent=2)+'\n')
print(json.dumps(payload,indent=2))
PY

# Preserve five representative native frames but avoid uploading hundreds of
# redundant JPEGs once their MP4 has been finalized.
python3 - "${FRAME_DIR}" "${ARTIFACT_DIR}" <<'PY'
import shutil
import sys
from pathlib import Path
frames=sorted(Path(sys.argv[1]).glob('*.jpg'))
out=Path(sys.argv[2])/'rubiks_preloaded_unsupported_retention_camera_keyframes'
out.mkdir(exist_ok=True)
if frames:
    indices=sorted(set([0, len(frames)//4, len(frames)//2, 3*len(frames)//4, len(frames)-1]))
    for i in indices:
        shutil.copy2(frames[i], out/f'{i:05d}_{frames[i].name}')
PY
rm -rf "${FRAME_DIR}"

# Preserve the physics result. Workflow validation independently gates camera
# quality, so a known retention failure remains distinguishable from recording failure.
exit "${TRIAL_STATUS}"
