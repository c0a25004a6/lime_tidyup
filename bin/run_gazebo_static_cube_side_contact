#!/usr/bin/env bash
set -eo pipefail

ARTIFACT_DIR="${1:-/artifacts}"
mkdir -p "${ARTIFACT_DIR}"

source /opt/ros/humble/setup.bash
source /project/lib_ws/install/setup.bash
source /root/turtlebot3_ws/install/setup.bash
set -u

export GAZEBO_MODEL_PATH="${GAZEBO_MODEL_PATH:-}:/root/.gazebo/models:/opt/ros/humble/share/turtlebot3_gazebo/models"
export GAZEBO_PLUGIN_PATH="${GAZEBO_PLUGIN_PATH:-}:/project/lib_ws/install/IFRA_LinkAttacher/lib:/opt/ros/humble/lib"

MODEL_NAME="turtlebot3_lime_gripper_test"
URDF_PATH="${ARTIFACT_DIR}/turtlebot3_lime_gripper_test.urdf"
SERVER_LOG="${ARTIFACT_DIR}/rubiks_static_cube_contact.gzserver.log"
RSP_LOG="${ARTIFACT_DIR}/rubiks_static_cube_contact.robot_state_publisher.log"
TELEMETRY="${ARTIFACT_DIR}/rubiks_static_cube_contact_telemetry.json"

cleanup() {
  status=$?
  for pid in "${GZSERVER_PID:-}" "${RSP_PID:-}"; do
    if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
      kill -INT "${pid}" 2>/dev/null || true
    fi
  done
  sleep 2
  for pid in "${GZSERVER_PID:-}" "${RSP_PID:-}"; do
    if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
      kill -TERM "${pid}" 2>/dev/null || true
      wait "${pid}" 2>/dev/null || true
    fi
  done
  exit "${status}"
}
trap cleanup EXIT INT TERM

ros2_service_available() {
  local service_type
  service_type="$(timeout 5 ros2 service type "$1" 2>/dev/null)" || return 1
  [[ -n "${service_type}" ]]
}

ros2_action_available() {
  local output
  local padded
  output="$(timeout 5 ros2 action list 2>/dev/null)" || return 1
  padded=$'\n'"${output}"$'\n'
  [[ "${padded}" == *$'\n'"$1"$'\n'* ]]
}

BUMPER_PLUGIN="$(find /opt/ros/humble/lib -name libgazebo_ros_bumper.so -print -quit)"
test -n "${BUMPER_PLUGIN}"
printf '%s\n' "${BUMPER_PLUGIN}" >"${ARTIFACT_DIR}/rubiks_static_cube_contact.bumper_plugin.txt"

xacro /project/resource/turtlebot3_lime_gripper_test.urdf.xacro >"${URDF_PATH}"
grep -q 'libgazebo_ros2_control.so' "${URDF_PATH}"
! grep -q 'libgazebo_grasp_fix.so' "${URDF_PATH}"
! grep -q 'librealsense_gazebo_plugin.so' "${URDF_PATH}"
! grep -q 'libgazebo_ros_diff_drive.so' "${URDF_PATH}"
! grep -q 'libgazebo_ros_ray_sensor.so' "${URDF_PATH}"

ros2 run robot_state_publisher robot_state_publisher "${URDF_PATH}" \
  --ros-args -p use_sim_time:=true \
  >"${RSP_LOG}" 2>&1 &
RSP_PID=$!
sleep 2
if ! kill -0 "${RSP_PID}" 2>/dev/null; then
  cat "${RSP_LOG}"
  exit 2
fi

gzserver /project/resource/rubiks_grasp_calibration.world \
  -s libgazebo_ros_init.so \
  -s libgazebo_ros_factory.so \
  >"${SERVER_LOG}" 2>&1 &
GZSERVER_PID=$!

for _ in $(seq 1 90); do
  if ros2_service_available '/spawn_entity'; then
    break
  fi
  kill -0 "${GZSERVER_PID}" 2>/dev/null || { cat "${SERVER_LOG}"; exit 3; }
  sleep 1
done
if ! ros2_service_available '/spawn_entity'; then
  ros2 service list >"${ARTIFACT_DIR}/rubiks_static_cube_contact.services_spawn_failure.txt" 2>&1 || true
  cat "${SERVER_LOG}"
  exit 3
fi

ros2 run gazebo_ros spawn_entity.py \
  -entity "${MODEL_NAME}" \
  -file "${URDF_PATH}" \
  -x 0.0 -y 0.0 -z 0.03 -Y 0.0 \
  >"${ARTIFACT_DIR}/rubiks_static_cube_contact.robot_spawn.log" 2>&1

for _ in $(seq 1 90); do
  if ros2_service_available '/controller_manager/list_controllers'; then
    break
  fi
  kill -0 "${GZSERVER_PID}" 2>/dev/null || { cat "${SERVER_LOG}"; exit 4; }
  sleep 1
done
if ! ros2_service_available '/controller_manager/list_controllers'; then
  ros2 service list >"${ARTIFACT_DIR}/rubiks_static_cube_contact.services_controller_failure.txt" 2>&1 || true
  cat "${SERVER_LOG}"
  exit 4
fi

ros2 run controller_manager spawner joint_state_broadcaster \
  --controller-manager /controller_manager \
  >"${ARTIFACT_DIR}/static_cube_joint_state_broadcaster.spawner.log" 2>&1
ros2 run controller_manager spawner gripper_controller \
  --controller-manager /controller_manager \
  >"${ARTIFACT_DIR}/static_cube_gripper_controller.spawner.log" 2>&1

for _ in $(seq 1 60); do
  if ros2_action_available '/gripper_controller/gripper_cmd'; then
    break
  fi
  sleep 1
done
if ! ros2_action_available '/gripper_controller/gripper_cmd'; then
  ros2 action list >"${ARTIFACT_DIR}/rubiks_static_cube_contact.actions_failure.txt" 2>&1 || true
  exit 5
fi

sleep 3
ros2 topic list >"${ARTIFACT_DIR}/rubiks_static_cube_contact.topics_before.txt"
gz topic -l >"${ARTIFACT_DIR}/rubiks_static_cube_contact.gz_topics_before.txt" 2>&1 || true
ros2 control list_hardware_interfaces \
  >"${ARTIFACT_DIR}/rubiks_static_cube_contact.hardware_interfaces.txt" 2>&1 || true

set +e
python3 /root/bin/run_rubiks_static_cube_contact.py \
  --cube-sdf /project/resource/rubiks_static_cube_contact_057.sdf \
  --cube-width 0.057 \
  --combined-inner-face-offset 0.003000000004097683 \
  --calibration-uncertainty 0.0003279557798182653 \
  --reference-frame "${MODEL_NAME}::link7" \
  --cube-x -0.019 \
  --cube-y 0.0 \
  --cube-z 0.1007 \
  --close-start 0.0185 \
  --close-stop 0.0060 \
  --close-step 0.00025 \
  --step-hold 0.12 \
  --max-effort 0.25 \
  --timeout 8.0 \
  --output "${TELEMETRY}" \
  >"${ARTIFACT_DIR}/rubiks_static_cube_contact.stdout.json" \
  2>"${ARTIFACT_DIR}/rubiks_static_cube_contact.stderr.log"
TRIAL_STATUS=$?
set -e

ros2 topic list >"${ARTIFACT_DIR}/rubiks_static_cube_contact.topics_after.txt" || true
timeout 5 ros2 topic echo --once /rubiks_cube_contact/contact_states \
  >"${ARTIFACT_DIR}/rubiks_static_cube_contact.contact_states_after.yaml" 2>&1 || true

python3 - "${ARTIFACT_DIR}" "${TRIAL_STATUS}" <<'PY'
from __future__ import annotations

import json
import math
from pathlib import Path
import sys

root = Path(sys.argv[1])
process_status = int(sys.argv[2])
telemetry_path = root / "rubiks_static_cube_contact_telemetry.json"
if not telemetry_path.is_file():
    raise SystemExit("static-cube telemetry was not written")
data = json.loads(telemetry_path.read_text(encoding="utf-8"))
errors = [str(error) for error in data.get("errors", [])]
if process_status != 0 and not errors:
    errors.append(f"trial process exited with status {process_status}")

if data.get("trial_type") != "gazebo_static_rubiks_cube_side_contact":
    errors.append("unexpected trial_type")
if data.get("hardware_backend") != "gazebo_ros2_control":
    errors.append("unexpected hardware backend")
if data.get("source_cube_collision_size_m") != [0.057, 0.057, 0.057]:
    errors.append("cube collision is not exactly 57 mm on every axis")
for key in (
    "cube_spawned",
    "cube_static",
    "cube_contact",
    "left_cube_contact_observed",
    "right_cube_contact_observed",
    "dual_cube_contact_observed",
    "contact_cleared_after_reopen",
    "calibration_applied",
):
    if data.get(key) is not True:
        errors.append(f"{key} must be true")
if data.get("initial_open_contact") is not False:
    errors.append("cube must not contact the open gripper")
if int(data.get("unexpected_robot_contact_count", -1)) != 0:
    errors.append("cube contacted a non-finger robot collision")
for key in (
    "cube_mass_dynamics_tested",
    "arm_motion_performed",
    "lift_command_sent",
    "cube_lifted",
    "ifra_attachment_used",
    "grasp_success_claimed",
):
    if data.get(key) is not False:
        errors.append(f"{key} must remain false")

result = data.get("contact_result") or {}
opening = result.get("accepted_contact_inner_opening_m")
opening_error = result.get("opening_error_m")
tolerance = result.get("acceptance_tolerance_m")
if opening is None or not 0.056 <= float(opening) <= 0.058:
    errors.append(f"unexpected calibrated contact opening: {opening}")
if opening_error is None or tolerance is None or abs(float(opening_error)) > float(tolerance):
    errors.append(f"opening error exceeds tolerance: {opening_error} > {tolerance}")
if int(result.get("dual_contact_sample_count", 0)) < 1:
    errors.append("no dual-contact samples")
if float(result.get("max_contact_depth_m", 1.0)) > 0.001:
    errors.append("contact penetration exceeds 1 mm")

cube_displacement = data.get("cube_displacement_m")
cube_rotation = data.get("cube_rotation_rad")
if cube_displacement is None or float(cube_displacement) > 1e-6:
    errors.append(f"static cube displacement too large: {cube_displacement}")
if cube_rotation is None or float(cube_rotation) > 1e-6:
    errors.append(f"static cube rotation too large: {cube_rotation}")
base_displacement = data.get("robot_base_displacement_m")
final_speed = data.get("robot_final_linear_speed_m_s")
if base_displacement is None or float(base_displacement) > 0.05:
    errors.append(f"robot base displacement too large: {base_displacement}")
if final_speed is None or float(final_speed) > 0.05:
    errors.append(f"robot final speed too high: {final_speed}")

samples = data.get("samples", [])
contacts = data.get("contact_messages", [])
if len(samples) < 50:
    errors.append(f"insufficient samples: {len(samples)}")
if not contacts:
    errors.append("contact evidence is empty")
if any(
    sample.get("inner_face_opening_m") is None
    for sample in samples
    if sample.get("link_frame_separation_m") is not None
):
    errors.append("calibrated samples contain a missing inner-face opening")

summary = {
    "schema_version": 1,
    "trial_type": data.get("trial_type"),
    "hardware_backend": data.get("hardware_backend"),
    "passed": not errors,
    "errors": errors,
    "process_status": process_status,
    "sample_count": len(samples),
    "contact_message_count": len(contacts),
    "event_labels": [event.get("label") for event in data.get("events", [])],
    "cube_width_m": data.get("cube_width_m"),
    "cube_static": data.get("cube_static"),
    "cube_pose_relative_to": data.get("cube_pose_relative_to"),
    "cube_pose_xyz_m": data.get("cube_pose_xyz_m"),
    "initial_open_contact": data.get("initial_open_contact"),
    "left_cube_contact_observed": data.get("left_cube_contact_observed"),
    "right_cube_contact_observed": data.get("right_cube_contact_observed"),
    "dual_cube_contact_observed": data.get("dual_cube_contact_observed"),
    "contact_cleared_after_reopen": data.get("contact_cleared_after_reopen"),
    "contact_result": result,
    "cube_displacement_m": cube_displacement,
    "cube_rotation_rad": cube_rotation,
    "robot_base_displacement_m": base_displacement,
    "robot_final_linear_speed_m_s": final_speed,
    "cube_mass_dynamics_tested": False,
    "arm_motion_performed": False,
    "lift_command_sent": False,
    "cube_lifted": False,
    "ifra_attachment_used": False,
    "grasp_success_claimed": False,
}
(root / "rubiks_static_cube_contact_summary.json").write_text(
    json.dumps(summary, indent=2) + "\n", encoding="utf-8"
)
manifest = {
    "schema_version": 1,
    "evidence_type": "gazebo_static_rubiks_cube_side_contact",
    "source": (
        "static 57 mm Rubik collision, Gazebo contact sensor, gazebo_ros2_control, "
        "GripperCommand, /joint_states, /link_states, and /model_states"
    ),
    "calibration_source_pr": 5,
    "combined_inner_face_offset_m": data.get("combined_inner_face_offset_m"),
    "calibration_uncertainty_m": data.get("calibration_uncertainty_m"),
    "production_urdf_modified": False,
    "cube_static": True,
    "cube_mass_dynamics_tested": False,
    "arm_motion_performed": False,
    "lift_command_sent": False,
    "cube_lifted": False,
    "ifra_attachment_used": False,
    "grasp_success_claimed": False,
    "review_required": True,
    "files": {
        "expanded_urdf": "turtlebot3_lime_gripper_test.urdf",
        "cube_sdf": "rubiks_static_cube_contact_057.sdf",
        "telemetry": telemetry_path.name,
        "summary": "rubiks_static_cube_contact_summary.json",
        "video": "rubiks_static_cube_contact_telemetry_evidence.mp4",
    },
}
(root / "rubiks_static_cube_contact_evidence.manifest.json").write_text(
    json.dumps(manifest, indent=2) + "\n", encoding="utf-8"
)
print(json.dumps(summary, indent=2))
if errors:
    raise SystemExit("; ".join(errors))
PY
