<?xml version="1.0"?>
<sdf version="1.7">
  <model name="rubiks_dynamic_cube_supported_057">
    <!-- Test-only dynamic copy of the canonical 57 mm, 90 g Rubik model. -->
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>
    <link name="cube_link">
      <inertial>
        <mass>0.09</mass>
        <inertia>
          <ixx>4.8735e-05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>4.8735e-05</iyy><iyz>0</iyz><izz>4.8735e-05</izz>
        </inertia>
      </inertial>
      <collision name="cube_collision">
        <geometry><box><size>0.057 0.057 0.057</size></box></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          <bounce><restitution_coefficient>0.0</restitution_coefficient></bounce>
          <contact>
            <collide_without_contact>false</collide_without_contact>
            <ode><max_vel>0.001</max_vel><min_depth>0.00001</min_depth></ode>
          </contact>
        </surface>
        <max_contacts>40</max_contacts>
      </collision>
      <visual name="black_body">
        <geometry><box><size>0.057 0.057 0.057</size></box></geometry>
        <material><ambient>0.005 0.005 0.005 1</ambient><diffuse>0.005 0.005 0.005 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
      </visual>
      <visual name="face_px_red"><pose>0.02875 0 0 0 0 0</pose><geometry><box><size>0.0005 0.057 0.057</size></box></geometry><material><ambient>0.8 0.02 0.02 1</ambient><diffuse>0.8 0.02 0.02 1</diffuse></material></visual>
      <visual name="face_nx_orange"><pose>-0.02875 0 0 0 0 0</pose><geometry><box><size>0.0005 0.057 0.057</size></box></geometry><material><ambient>1 0.22 0 1</ambient><diffuse>1 0.22 0 1</diffuse></material></visual>
      <visual name="face_py_blue"><pose>0 0.02875 0 0 0 0</pose><geometry><box><size>0.057 0.0005 0.057</size></box></geometry><material><ambient>0.02 0.12 0.85 1</ambient><diffuse>0.02 0.12 0.85 1</diffuse></material></visual>
      <visual name="face_ny_green"><pose>0 -0.02875 0 0 0 0</pose><geometry><box><size>0.057 0.0005 0.057</size></box></geometry><material><ambient>0.02 0.65 0.1 1</ambient><diffuse>0.02 0.65 0.1 1</diffuse></material></visual>
      <visual name="face_pz_white"><pose>0 0 0.02875 0 0 0</pose><geometry><box><size>0.057 0.057 0.0005</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      <visual name="face_nz_yellow"><pose>0 0 -0.02875 0 0 0</pose><geometry><box><size>0.057 0.057 0.0005</size></box></geometry><material><ambient>0.95 0.85 0.02 1</ambient><diffuse>0.95 0.85 0.02 1</diffuse></material></visual>
      <sensor name="cube_contact_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>500</update_rate>
        <visualize>false</visualize>
        <contact><collision>cube_collision</collision></contact>
        <plugin name="rubiks_dynamic_cube_contact_ros" filename="libgazebo_ros_bumper.so">
          <ros>
            <namespace>/rubiks_dynamic_cube_hold</namespace>
            <argument>bumper_states:=contact_states</argument>
          </ros>
          <frame_name>cube_link</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
