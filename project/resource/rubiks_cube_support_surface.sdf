<?xml version="1.0"?>
<sdf version="1.7">
  <model name="rubiks_cube_support_surface">
    <static>true</static>
    <link name="support_link">
      <collision name="support_collision">
        <geometry><box><size>0.075 0.040 0.010</size></box></geometry>
        <surface>
          <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          <bounce><restitution_coefficient>0.0</restitution_coefficient></bounce>
          <contact><ode><max_vel>0.001</max_vel><min_depth>0.00001</min_depth></ode></contact>
        </surface>
        <max_contacts>40</max_contacts>
      </collision>
      <visual name="support_visual">
        <geometry><box><size>0.075 0.040 0.010</size></box></geometry>
        <material><ambient>0.25 0.28 0.34 1</ambient><diffuse>0.25 0.28 0.34 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
