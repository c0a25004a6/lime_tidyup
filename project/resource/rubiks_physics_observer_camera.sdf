<?xml version="1.0"?>
<sdf version="1.7">
  <model name="rubiks_physics_observer_camera">
    <!-- Test-only, non-colliding camera. Spawned relative to link7, then fixed in world. -->
    <static>true</static>
    <link name="camera_link">
      <sensor name="rubiks_observer" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <camera name="rubiks_observer">
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <!-- Gazebo-native frame capture avoids ROS subscriber drops. The camera
               evidence runner uses Gazebo lockstep mode so requested 30 Hz stays
               synced to physics even when software rendering is slower than real time. -->
          <save enabled="true">
            <path>/artifacts/rubiks_preloaded_unsupported_retention_camera_frames</path>
          </save>
          <clip>
            <near>0.01</near>
            <far>5.0</far>
          </clip>
        </camera>
        <plugin name="rubiks_observer_ros_camera" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/rubiks_physics_camera</namespace>
          </ros>
          <camera_name>rubiks_observer</camera_name>
          <frame_name>rubiks_physics_observer_camera::camera_link</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
